# Copy to .env for local use (never commit .env). On Railway, set these as service variables.
# With no .env at all, `npm run dev` uses an in-memory embedded PostgreSQL (PGlite) and the PIN 2026.

# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}}).
# Leave empty locally to use the embedded development database (PGlite). Required when NODE_ENV=production.
DATABASE_URL=

# Use "production" only on a real deployment: it refuses the embedded database and requires IMAQ_ADMIN_PIN.
NODE_ENV=development
PORT=8080

# Prototype municipality access PIN (NOT authentication). Defaults to 2026 outside production; required in production.
IMAQ_ADMIN_PIN=

# Optional: if set, sensor gateways must send header X-Imaq-Device-Key with this value.
IMAQ_DEVICE_KEY=

# Optional: AI delivery risk assessment (server-side only; never sent to the browser).
# Without it, the "Assess risk" button shows Imaq's rule-based priority instead.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Synthetic sensors (hackathon hardware stand-in). Set to 0 once real monitors send readings.
IMAQ_SYNTHETIC_SENSORS=1

# Optional: persist the embedded development database to a folder (local only).
# IMAQ_LOCAL_DB_DIR=.localdb
