# Copy to .env for local use (never commit .env). On Railway, set these as service variables.

# Railway PostgreSQL connection string (Railway provides it; reference ${{Postgres.DATABASE_URL}}).
# Leave unset locally to use the embedded development database (PGlite). Required when NODE_ENV=production.
DATABASE_URL=

NODE_ENV=production
PORT=8080

# Prototype municipality access PIN (NOT authentication). Required in production.
IMAQ_ADMIN_PIN=

# Optional: if set, sensor gateways must send header X-Imaq-Device-Key with this value.
IMAQ_DEVICE_KEY=

# Synthetic sensors (hackathon hardware stand-in). Set to 0 once real monitors send readings.
IMAQ_SYNTHETIC_SENSORS=1

# Optional: persist the embedded development database to a folder (local only).
# IMAQ_LOCAL_DB_DIR=.localdb
